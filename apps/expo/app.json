{
  "expo": {
    "name": "MedusaPOS",
    "slug": "medusapos",
    "version": "0.2.0",
    "scheme": "medusapos",
    "web": {
      "description": "MedusaPOS is an open-source point of sale for Medusa stores. Try the demo in one click; demo data resets nightly.",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": "production"
          }
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
