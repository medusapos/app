{
  "name": "@medusapos/expo",
  "license": "MIT",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": { "node": "22.x" },
  "scripts": {
    "build:sqlite-worker": "tallyui-build-sqlite-worker public/sqlite",
    "dev": "pnpm run build:sqlite-worker && expo start",
    "build:web": "pnpm run build:sqlite-worker && expo export --platform web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "pnpm run build:sqlite-worker && expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@sqlite.org/sqlite-wasm": "3.53.4-build1",
    "@tallyui/components": "3.2.1",
    "@tallyui/connector-medusa": "3.2.1",
    "@tallyui/core": "3.2.1",
    "@tallyui/database": "3.2.1",
    "@tallyui/pos": "3.2.1",
    "@tallyui/primitives": "3.2.1",
    "@tallyui/storage-sqlite": "3.2.1",
    "@tallyui/theme": "3.2.1",
    "expo": "~54.0.0",
    "expo-linking": "~8.0.11",
    "expo-localization": "~17.0.9",
    "expo-router": "~6.0.0",
    "expo-status-bar": "~3.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.0",
    "react-native-safe-area-context": "~5.4.0",
    "react-native-screens": "~4.11.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.2",
    "rxdb": "17.5.0",
    "rxdb-premium": "17.5.0",
    "rxjs": "7.8.2",
    "tailwindcss": "^4.1.18",
    "uniwind": "^1.2.2"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "esbuild": "0.27.3",
    "typescript": "~5.8.3"
  }
}
