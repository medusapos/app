{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@tallyui/core": ["./node_modules/@tallyui/core/src/index.ts"],
      "@tallyui/components": ["./node_modules/@tallyui/components/src/index.ts"],
      "@tallyui/database": ["./node_modules/@tallyui/database/src/index.ts"],
      "@tallyui/pos": ["./node_modules/@tallyui/pos/src/index.ts"],
      "@tallyui/primitives": ["./node_modules/@tallyui/primitives/src/index.ts"],
      "@tallyui/theme": ["./node_modules/@tallyui/theme/src/index.ts"],
      "@tallyui/connector-medusa": ["./node_modules/@tallyui/connector-medusa/src/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "uniwind-env.d.ts"]
}
