{
  "framework": null,
  "installCommand": "bash ../../scripts/vercel-install.sh",
  "buildCommand": "EXPO_PUBLIC_MEDUSA_URL=https://demo-api.medusapos.com CI=1 pnpm run build:web && bash ../../scripts/check-web-bundle.sh dist",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "destination": "/demo",
      "permanent": false,
      "has": [{ "type": "host", "value": "demo.medusapos.com" }]
    }
  ],
  "rewrites": [
    { "source": "/robots.txt", "has": [{ "type": "host", "value": "demo.medusapos.com" }], "destination": "/robots-demo.txt" },
    { "source": "/robots.txt", "has": [{ "type": "host", "value": "app.medusapos.com" }], "destination": "/robots-app.txt" },
    { "source": "/((?!_expo/|assets/|sqlite/|robots\\.txt$|sitemap\\.xml$).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob: http://localhost:* http://127.0.0.1:*; connect-src 'self' https: http://localhost:* http://127.0.0.1:*; font-src 'self' data:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/_expo/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/demo",
      "has": [{ "type": "host", "value": "demo.medusapos.com" }],
      "headers": [
        { "key": "Link", "value": "<https://demo.medusapos.com/demo>; rel=\"canonical\"" }
      ]
    }
  ]
}
