{
  "private": true,
  "name": "@medusapos/monorepo",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "turbo dev",
    "dev:expo": "turbo dev --filter=@medusapos/expo",
    "dev:desktop": "turbo dev --filter=@medusapos/desktop",
    "build": "turbo build",
    "test": "vitest run",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean"
  },
  "dependencies": {
    "turbo": "^2.5.0",
    "typescript": "~5.8.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "jsdom": "^28.1.0",
    "react-native-web": "~0.21.2",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "rxdb",
      "esbuild",
      "electron"
    ],
    "overrides": {
      "@tallyui/core": "file:../tallyui/packages/core",
      "@tallyui/components": "file:../tallyui/packages/components",
      "@tallyui/database": "file:../tallyui/packages/database",
      "@tallyui/pos": "file:../tallyui/packages/pos",
      "@tallyui/primitives": "file:../tallyui/packages/primitives",
      "@tallyui/theme": "file:../tallyui/packages/theme",
      "@tallyui/connector-medusa": "file:../tallyui/connectors/medusa"
    }
  }
}
